
# Firebase web app configuration (Firebase Console > Project settings > Your apps > Web app).
# These values identify your Firebase project; they are not secrets. Data security comes
# from Firebase Authentication and the Firestore Security Rules in firestore.rules.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: connect to the local Firebase Emulator Suite instead of production (development only).
# VITE_USE_FIREBASE_EMULATORS=true

# Optional: store invoice files in Firebase Cloud Storage (requires the Blaze plan and deployed
# storage.rules). When unset, invoice files stay on the user's device (IndexedDB).
# VITE_FIREBASE_CLOUD_FILES=true
