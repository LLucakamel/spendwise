# Used only by `npm run test:e2e:firebase` (vite --mode emulator). Points the app at the local
# Firebase Emulator Suite with a demo-* project ID, so no real project is touched. Not secrets.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-spendwise.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-spendwise
VITE_FIREBASE_APP_ID=1:1234:web:emulator
VITE_USE_FIREBASE_EMULATORS=true
